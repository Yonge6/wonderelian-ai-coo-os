# App Store Connect API. Keep the .p8 outside this repository.
ASC_ISSUER_ID=
ASC_KEY_ID=
ASC_PRIVATE_KEY_PATH=
ASC_APP_ID=
ASC_BUNDLE_ID=com.xiazishuo.styleatlas

# Google Search Console. The property string must exactly match Search Console.
GOOGLE_APPLICATION_CREDENTIALS=
GSC_SITE_URL=

# Optional one-run token; never commit or persist it.
GSC_ACCESS_TOKEN=
